# mock 演示不发送任何模型请求，不产生费用。
FISHWORLD_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
FISHWORLD_PORT=8765
# 默认 0：不按轮数要求人工确认；需要每五轮确认时改为 5 并重启。
FISHWORLD_CONFIRM_EVERY=0
# 数据库和临时玩家核心仅保存在本地，绝不能提交。
FISHWORLD_DB=data/fishworld.db
# 可选：其他服务商的所有者自填人民币单价；格式见 README。
# FISHWORLD_CUSTOM_PRICING_FILE=local/pricing.json
